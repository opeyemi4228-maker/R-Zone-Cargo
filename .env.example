# ════════════════════════════════════════════════════════════════════════════
#  R-Zone Cargo — environment template
#  Copy to .env and fill in real values:  cp .env.example .env
# ════════════════════════════════════════════════════════════════════════════

# ─── Database (Postgres via Prisma) ─────────────────────────────────────────
# postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL=""

# ─── Admin login ────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@rzonecargo.com"
ADMIN_PASSWORD=""
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=""

# ─── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM="R-Zone Cargo <onboarding@resend.dev>"
ADMIN_NOTIFY_EMAIL=""

# ─── Public ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CURRENCY=$
